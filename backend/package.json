{
  "name": "colegio-manantial-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Base oficial del backend de Colegio Manantial",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "pretest": "npm run prisma:generate",
    "test": "node ./scripts/run-tests.mjs",
    "pretest:e2e": "npm run prisma:generate",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --no-file-parallelism",
    "prisma:generate": "prisma generate --config ./prisma7.config.ts",
    "prisma:validate": "prisma validate --config ./prisma7.config.ts",
    "prisma:format": "prisma format --config ./prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config ./prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config ./prisma7.config.ts",
    "prisma:studio": "prisma studio --config ./prisma7.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/node": "24.10.13",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
